      "xl": "0 8px 10px -6px rgba(0,0,0,0.10), 0 20px 25px -5px rgba(0,0,0,0.10)",
      "2xl": "0 25px 50px -12px rgba(0,0,0,0.25)"
    },
    "upper": {
      "xs": "0 -1px 2px -1px rgba(0,0,0,0.10), 0 -1px 3px 0 rgba(0,0,0,0.10)",
      "sm": "0 -1px 2px 0 rgba(0,0,0,0.05)",
      "md": "0 -2px 4px -2px rgba(0,0,0,0.10), 0 -4px 6px -1px rgba(0,0,0,0.10)",
