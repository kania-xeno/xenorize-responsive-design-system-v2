      "brandPrimary": "0 0 0 1px #9483C9, 0 1px 2px rgba(18,17,15,0.24)",
      "brandSecondary": "0 0 0 1px #178C7D, 0 1px 2px rgba(18,17,15,0.24)",
      "destructive": "0 0 0 1px #CB1515, 0 1px 2px rgba(18,17,15,0.24)",
